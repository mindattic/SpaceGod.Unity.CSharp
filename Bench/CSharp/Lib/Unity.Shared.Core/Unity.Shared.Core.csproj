<Project Sdk="Microsoft.NET.Sdk">
  <!-- The embedded Unity.Shared package's engine-free core (Packages/com.mindattic.unity.shared/Runtime/Core, see
       Packages/VENDORED.md), compiled in place for the Bench as Unity compiles it (netstandard2.1, C# 9). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Unity.Shared.Core</AssemblyName>
    <RootNamespace>Unity.Shared.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <SharedPackageDir>$(MSBuildThisFileDirectory)../../../../Packages/com.mindattic.unity.shared/</SharedPackageDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SharedPackageDir)Runtime/Core/**/*.cs" LinkBase="Core" />
  </ItemGroup>
</Project>